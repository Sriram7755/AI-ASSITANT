# Local Ollama LLM Configuration
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen2.5:1.5b

# Speech to Text Model (faster-whisper)
WHISPER_MODEL=tiny.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Wake Word & Speech
WAKE_WORD="hey jarvis"
TTS_VOICE=en-US-ChristopherNeural
TTS_RATE=+0%
TTS_VOLUME=+0%

# Directories & Allowed Paths
ALLOWED_DIRECTORIES=C:\Users,D:\
CONFIRMATION_REQUIRED_TOOLS=shutdown_computer,restart_computer,delete_file,mass_file_move

# Logging & Storage
LOG_LEVEL=INFO
DATA_DIR=data
LOG_DIR=logs
